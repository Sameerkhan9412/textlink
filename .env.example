# MongoDB Atlas connection string (database name at the end of the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/textlink?retryWrites=true&w=majority

# Public origin of the site (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host shown in the link prefix before hydration, e.g. textlink.com
NEXT_PUBLIC_SITE_HOST=textlink.com
